										"type": "Expression"
									},
									"username": {
										"value": "@activity('source_connection_info').output.firstRow.username",
										"type": "Expression"
									},
									"database": "postgresql-canc-edhoper-34001-dev-7taleugbxhski",
									"validate_server_certificate": "N",
									"keyvault_name": {
										"value": "@pipeline().globalParameters.nodeLevelKeyVault",
										"type": "Expression"

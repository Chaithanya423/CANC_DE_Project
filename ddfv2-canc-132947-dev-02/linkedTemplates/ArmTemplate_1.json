		{
			"name": "[concat(parameters('factoryName'), '/RDBMS_Ingestion_Batch_Layer')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Find entity_coordinate based on the provided group_id ordered by the execution order in group.",
				"activities": [
					{
						"name": "Query Ingestion Platform",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlMISource",
								"sqlReaderQuery": {
									"value": "select Platform, IIF(ISJSON(additional_info) = 1, COALESCE(JSON_QUERY(additional_info, '$.cluster_init_scripts'), '[]'), '[]') as cluster_init_scripts\nfrom ingest.rdbms_group_info where DDP_TABLE_GROUP_COORDINATE = '@{pipeline().parameters.group_id}'\nunion select 'ADF' as platform, '[]' as cluster_init_scripts\nwhere not exists (select 1 from ingest.rdbms_group_info where DDP_TABLE_GROUP_COORDINATE = '@{pipeline().parameters.group_id}')",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_EDGE_META_DATA_RW",
								"type": "DatasetReference",
								"parameters": {
									"env": {
										"value": "@pipeline().parameters.env",
										"type": "Expression"
									},
									"keyVault": {
										"value": "@pipeline().globalParameters.nodeLevelKeyVault",
										"type": "Expression"
									}
								}
							}
						}
					},
					{
						"name": "Platform Router",
						"description": "Choose the option between ADF and Databricks to do the ingestion",
						"type": "Switch",
						"dependsOn": [
							{
								"activity": "Query Ingestion Platform",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@if(equals(variables('platform'), 'DBR'), 'DBR', 'ADF')",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "DBR",
									"activities": [
										{
											"name": "RDBMS DBR Ingestion",
											"type": "ExecutePipeline",
											"dependsOn": [],
											"policy": {
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"pipeline": {
													"referenceName": "RDBMS_DBR_Ingestion",
													"type": "PipelineReference"
												},
												"waitOnCompletion": true,
												"parameters": {
													"group_id": {
														"value": "@pipeline().parameters.group_id",
														"type": "Expression"
													},
													"env": {
														"value": "@pipeline().parameters.env",
														"type": "Expression"
													},
													"dupSkip": {
														"value": "@pipeline().parameters.dupSkip",
														"type": "Expression"
													},
													"debugMode": {
														"value": "@pipeline().parameters.debugMode",
														"type": "Expression"
													},
													"callBackId": {
														"value": "@pipeline().parameters.callBackId",
														"type": "Expression"
													},
													"callBackUrl": {
														"value": "@pipeline().parameters.callBackUrl",
														"type": "Expression"
													},
													"clusterInitScripts": {
														"value": "@json(replace(activity('Query Ingestion Platform').output.value[0].cluster_init_scripts, concat(pipeline().parameters.env), 'type'))",
														"type": "Expression"
													}
												}
											}
										}
									]
								},
								{
									"value": "ADF",
									"activities": [
										{
											"name": "RDBMS ADF Ingestion",
											"type": "ExecutePipeline",
											"dependsOn": [],
											"policy": {
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"pipeline": {
													"referenceName": "RDBMS_ADF_Ingestion",
													"type": "PipelineReference"
												},
												"waitOnCompletion": true,
												"parameters": {
													"group_id": {
														"value": "@pipeline().parameters.group_id",
														"type": "Expression"
													},
													"env": {
														"value": "@pipeline().parameters.env",
														"type": "Expression"
													}
												}
											}
										}
									]
								}
							],
							"defaultActivities": [
								{
									"name": "SendOrchFailed",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "SendOrchFailedMsg",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"groupLvlFailure": true,
											"callBackUrl": {
												"value": "@pipeline().parameters.callBackUrl",
												"type": "Expression"
											},
											"callBackId": {
												"value": "@pipeline().parameters.callBackId",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"group_id": {
						"type": "string"
					},
					"env": {
						"type": "string"
					},
					"dupSkip": {
						"type": "bool",
						"defaultValue": true
					},
					"callBackUrl": {
						"type": "string"
					},
					"callBackId": {
						"type": "string"
					},
					"debugMode": {
						"type": "bool"
					},
					"clusterInitScripts": {
						"type": "Array"
					}
				},
				"variables": {
					"platform": {
						"type": "String"
					}
				},
				"folder": {
					"name": "RDBMS_Ingestion"
				},
				"annotations": [],
				"lastPublishTime": "2026-06-24T20:05:21Z"
			},
			"dependsOn": []
		}
	]
}
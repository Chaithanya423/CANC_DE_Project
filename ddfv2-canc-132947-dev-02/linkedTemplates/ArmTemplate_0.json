						"type": "string"
					},
					"env": {
						"type": "string",
						"defaultValue": "site6"
					},
					"dupSkip": {
						"type": "bool",
						"defaultValue": true
					},
					"debugMode": {
						"type": "bool",
						"defaultValue": true
					},
					"callBackUrl": {
						"type": "string"
					},
					"callBackId": {
						"type": "string"
					},
					"clusterInitScripts": {
						"type": "array"
					}
				},
				"variables": {

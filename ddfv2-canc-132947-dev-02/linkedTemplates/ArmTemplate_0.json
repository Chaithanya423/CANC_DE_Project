							"type": "Expression"
						},
						"ENV": {
							"value": "@linkedService().env",
							"type": "Expression"
						},
						"PYSPARK_PYTHON": "/databricks/python3/bin/python3"
					},
					"newClusterVersion": "@linkedService().clusterVersion",
					"newClusterLogDestination": "@linkedService().cluster_log_path",
					"newClusterInitScripts": "@linkedService().clusterInitScripts",
					"clusterOption": "@linkedService().clusterOption",
					"DP_ID": {
						"value": "@linkedService().dp_id",
						"type": "Expression"
					},
					"workloadType": {

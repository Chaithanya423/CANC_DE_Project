		{
			"name": "[concat(parameters('factoryName'), '/Update_Incremental_Identification')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "This template can be used to submit notebook runs to a Databricks Workspace using serverless jobs compute.",
				"activities": [
					{
						"name": "Execute Jobs API",
						"description": "This task submits the notebook to the run submit API endpoint. It returns the runID of the job. Task and run name only accepts - and _, all other non-alphanumeric characters are converted for compatibility.",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.01:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 90,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {},
							"url": {
								"value": "@concat(pipeline().globalParameters.databricksWorkspace, '/api/2.2/jobs/runs/submit')",
								"type": "Expression"
							},
							"body": {
								"value": "{\n  \"run_name\": \"@{concat(pipeline().parameters.entity_coordinate, '_', replace(pipeline().Pipeline, ' ', '_'), '_', pipeline().RunId)}\",\n  \"tasks\": [{\n    \"task_key\": \"@{replace(concat(pipeline().parameters.entity_coordinate, '_', replace(pipeline().Pipeline, ' ', '_'), '_', pipeline().RunId), '.', '_')}\",\n    \"notebook_task\": {\n      \"base_parameters\": {\n        \"filePath\": \"@{pipeline().parameters.filePath}\",\n        \"deltaField\": \"@{pipeline().parameters.deltaField}\",\n        \"lastTimestampCutoff\": \"@{pipeline().parameters.lastValueCutoff}\",\n        \"storageAccount\": \"@{pipeline().globalParameters.adlsStorageAcctUrl}\",\n        \"env\": \"@{pipeline().parameters.env}\"\n      },\n      \"notebook_path\": \"/edge_foundation_utilities/RDBMS/insert_new_incr\",\n      \"source\": \"WORKSPACE\"\n    }\n  }]\n}",
								"type": "Expression"
							},
							"authentication": {
								"type": "MSI",
								"resource": "24f21426-3304-4ab8-85cb-cd0e0f879c1d"
							}
						}
					},
					{
						"name": "Wait Until Job Completes",
						"type": "Until",
						"dependsOn": [
							{
								"activity": "Execute Jobs API",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(variables('JobStatus'), 'Running'))",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Check Job Run API",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.01:00:00",
										"retry": 3,
										"retryIntervalInSeconds": 90,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"headers": {},
										"url": {
											"value": "@concat(pipeline().globalParameters.databricksWorkspace, '/api/2.2/jobs/runs/get?run_id=', activity('Execute Jobs API').output.run_id)",
											"type": "Expression"
										},
										"connectVia": {
											"referenceName": "SelfHosted-141945",
											"type": "IntegrationRuntimeReference"
										},
										"body": {
											"job_id": 3895
										},
										"authentication": {
											"type": "MSI",
											"resource": "24f21426-3304-4ab8-85cb-cd0e0f879c1d"
										}
									}
								},
								{
									"name": "Set Job Status",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Check Job Run API",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "JobStatus",
										"value": {
											"value": "@if(or(equals(activity('Check Job Run API').output.state.life_cycle_state,'PENDING'),equals(activity('Check Job Run API').output.state.life_cycle_state,'RUNNING')),'Running',activity('Check Job Run API').output.state.result_state)",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Wait to Recheck API",
									"type": "Wait",
									"dependsOn": [
										{
											"activity": "Set Job Status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": {
											"value": "@pipeline().parameters.ADFWaitSeconds",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "7.00:00:00"
						}
					},
					{
						"name": "Check Job Status",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Wait Until Job Completes",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(variables('JobStatus'), 'SUCCESS')",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "Databricks Job Fail",
									"description": "The Databricks job has failed.",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": {
											"value": "@concat('Job Run URL: ', activity('Check Job Run API').output.run_page_url)",
											"type": "Expression"
										},
										"errorCode": "Databricks Error"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"ADFWaitSeconds": {
						"type": "int",
						"defaultValue": 30
					},
					"entity_coordinate": {
						"type": "string"
					},
					"delta_identifier": {
						"type": "string"
					},
					"filePath": {
						"type": "string"
					},
					"deltaField": {
						"type": "string"
					},
					"ingestionID": {
						"type": "string"
					},
					"env": {
						"type": "string"
					},
					"parentID": {
						"type": "string"
					},
					"lastValueCutOff": {
						"type": "string"
					},
					"JobStatus": {
						"type": "String",
						"defaultValue": "Running"
					},
					"NotebookParams": {
						"type": "String"
					},
					"JobOutput": {
						"type": "String"
					}
				},
				"variables": {
					"JobStatus": {
						"type": "String",
						"defaultValue": "running"
					}
				},
				"folder": {
					"name": "RDBMS_Ingestion"
				},
				"annotations": [],
				"lastPublishTime": "2026-06-24T20:05:20Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/SelfHosted-141945')]"
			]
		},

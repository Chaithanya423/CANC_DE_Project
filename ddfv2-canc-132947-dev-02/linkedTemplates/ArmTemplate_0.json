					"base_path": {
						"type": "string"
					},
					"cluster_log_path": {
						"type": "string"
					},
					"clusterOption": {
						"type": "string",
						"defaultValue": "Autoscaling"
					},
					"clusterInitScripts": {
						"type": "array",
						"defaultValue": []
					},
					"dynamicSparkConf": {
						"type": "array",
						"defaultValue": []
					},
					"securityMode": {
						"type": "string",
						"defaultValue": ""
					},
					"policyId": {
						"type": "string",
						"defaultValue": ""
					}
				},
				"annotations": [],
				"typeProperties": {
					"domain": "https://4773100082275981.1.azuredatabricks.net",
					"authentication": "MSI",
					"workspaceResourceId": "/subscriptions/eea76cb6-864b-41ed-843d-146e3ab4956a/resourceGroups/dsube20_RG-CanC-RM-COMPUTE-DEV-141945/providers/Microsoft.Databricks/workspaces/ddbr-CanC-dbr-141945-1-dev-newb7h5kjrx3i",
					"instancePoolId": "@linkedService().poolId",
					"dataSecurityMode": "@linkedService().securityMode",
					"newClusterNumOfWorker": "@linkedService().workers",
					"policyId": {
						"value": "@if(not(empty(linkedService().policyId)), linkedService().policyId, null)",
						"type": "Expression"
					},
					"newClusterSparkConf": {
						"value": "@json(concat('{', '\"spark.databricks.delta.optimizeWrite.enabled\": \"true\",', '\"spark.databricks.delta.autoCompact.enabled\": \"true\"', if( and( not(equals(string(linkedService().dynamicSparkConf[0]), '{}')), greater(length(string(linkedService().dynamicSparkConf[0])), 2) ), concat(',', substring(string(linkedService().dynamicSparkConf[0]), 1, sub(length(string(linkedService().dynamicSparkConf[0])), 2))), ''), '}'))",
						"type": "Expression"
					},
